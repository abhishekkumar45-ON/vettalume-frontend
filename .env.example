# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.

# --- Backend the frontend talks to ---
# A) Backend running on THIS machine:
NEXT_PUBLIC_API_URL=http://localhost:8001
# B) ...or a shared/team backend over the internet (e.g. an ngrok tunnel to the host's backend):
#    NEXT_PUBLIC_API_URL=https://xxxxxxxx.ngrok-free.app

# --- Google sign-in ---
# The OAuth *client id* (public — safe to commit). Must be the SAME value as GOOGLE_CLIENT_ID
# in the backend's .env. Get it from the project owner or Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Dev-only ---
# Set to "true" to browse the whole UI without a backend or login (no real data on API pages).
# Leave unset for normal use.
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
